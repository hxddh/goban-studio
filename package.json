{
  "name": "goban-studio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Goban Studio — a beginner-first Go (围棋 · 바둑 · 囲碁) app for macOS and Windows.",
  "license": "MIT",
  "scripts": {
